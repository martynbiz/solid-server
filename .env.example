# Copy to .env and adjust. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically - no need to source it.

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# Port the server listens on *inside* the container.
CSS_PORT=3000

# Port published on the host. This is the one that matters in production -
# change it (e.g. 8080) if 3000 is already taken on the host, and point your
# reverse proxy at it.
HOST_PORT=3000

# Host interface the port is published on.
#   0.0.0.0   - reachable from other machines (fine for local dev)
#   127.0.0.1 - localhost only; use this in production so traffic must come
#               through your reverse proxy (Caddy/nginx) rather than hitting
#               the container directly.
HOST_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------

# The public URL the server is reached at, including trailing slash.
# This is baked into every WebID and resource URL the server mints, so it must
# match the real externally visible address - changing it later invalidates
# existing WebIDs. In production this is your HTTPS hostname, NOT the host port:
#   CSS_BASE_URL=https://pods.example.org/
CSS_BASE_URL=http://localhost:3000/

# Which built-in CSS config to run.
#   /config/default.json       - file-backed storage, accounts enabled (default)
#   /config/file-no-setup.json - file-backed, no initial setup page
#   /config/memory.json        - in-memory, wiped on restart (testing only)
CSS_CONFIG=/config/default.json

# error | warn | info | verbose | debug | silly
CSS_LOGGING_LEVEL=info

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------

# Pin this to a specific version in production (e.g. 7.1.7) so an upstream
# release cannot change your server under you.
CSS_IMAGE_TAG=latest

CONTAINER_NAME=solid-server

# Host path for pod data, bind-mounted to /data in the container.
DATA_DIR=./data
