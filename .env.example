# Copy to .env: cp .env.example .env

# Host port the server is published on. Change this in production if 3000
# is already in use on the host.
PORT=3000

# The server's real public URL, trailing slash included.
#
# REQUIRED in production, and it must be exact. CSS rejects any request
# whose Host doesn't match this - if it's wrong (or left as localhost while
# a reverse proxy fronts the server on a real domain), every request fails
# with "Request received for an unsupported path", including sign-up and
# every pod/resource on the server, not just registration.
#
# Local dev (default):
#   CSS_BASE_URL=http://localhost:3000/
# Behind a reverse proxy in production, e.g.:
#   CSS_BASE_URL=https://solid.example.org/
#
# Your reverse proxy must also forward the original Host/scheme (a
# `Forwarded` or `X-Forwarded-Proto`/`X-Forwarded-Host` header) so CSS can
# see the real request origin.
CSS_BASE_URL=http://localhost:3000/
